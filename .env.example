# Discord bot credentials
# Create an application at https://discord.com/developers/applications
# DISCORD_TOKEN:     Bot tab -> Reset Token
# DISCORD_CLIENT_ID: General Information tab -> Application ID
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional. When set, slash commands register to this server only and appear
# instantly (recommended for development). Leave empty to register globally.
# DISCORD_GUILD_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=

# SellAuth API credentials
# SELLAUTH_API_KEY: https://dash.sellauth.com/api (Account -> Developers)
# SELLAUTH_SHOP_ID: your shop's numeric ID
SELLAUTH_API_KEY=
SELLAUTH_SHOP_ID=
SELLAUTH_BASE_URL=https://api.sellauth.com/v1/
